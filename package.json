{
  "name": "smartbetbot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": "bash scripts/release-gate.sh",
    "deploy:preflight": "backend/.venv/bin/python backend/scripts/deployment_preflight.py",
    "deploy:smoke": "backend/.venv/bin/python backend/scripts/smoke_deployment.py",
    "db:lint": "bash scripts/db-lint.sh",
    "db:push": "bash scripts/db-push.sh",
    "db:push:dry": "bash scripts/db-push.sh --dry-run",
    "db:verify": "cd backend && .venv/bin/python scripts/verify_database.py",
    "provider:verify": "cd backend && .venv/bin/python -m scripts.verify_api_football",
    "worker:prematch": "cd backend && .venv/bin/python -m app.workers.prematch",
    "worker:live": "cd backend && .venv/bin/python -m app.workers.live",
    "worker:odds": "cd backend && .venv/bin/python -m app.workers.odds",
    "worker:probability": "cd backend && .venv/bin/python -m app.workers.probability",
    "worker:signals": "cd backend && .venv/bin/python -m app.workers.signals",
    "worker:settlement": "cd backend && .venv/bin/python -m app.workers.settlement",
    "worker:notifications": "cd backend && .venv/bin/python -m app.workers.notifications",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "firebase": "^12.18.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.5.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
