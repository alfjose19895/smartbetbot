ENVIRONMENT=development

SUPABASE_URL=
# Current Supabase server key (sb_secret_...). Never expose it in the frontend.
SUPABASE_SECRET_KEY=
# PostgreSQL URI from Supabase Connect. Prefer direct or the port 5432 session pooler for migrations.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=3
SUPABASE_JWT_AUDIENCE=authenticated

API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TIMEOUT_SECONDS=10
API_FOOTBALL_MAX_RETRIES=2
API_FOOTBALL_BACKOFF_BASE_SECONDS=0.5
API_FOOTBALL_BACKOFF_MAX_SECONDS=8
API_FOOTBALL_BACKOFF_JITTER_SECONDS=0.25
API_FOOTBALL_MAX_PAGES=20

# Free current-season catalog/fixtures/standings adapter.
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_TIMEOUT_SECONDS=10
FOOTBALL_DATA_MAX_RETRIES=2
FOOTBALL_DATA_BACKOFF_BASE_SECONDS=1
FOOTBALL_DATA_BACKOFF_MAX_SECONDS=15
FOOTBALL_DATA_BACKOFF_JITTER_SECONDS=0.25
API_USAGE_WRITE_TIMEOUT_SECONDS=2
SPORTS_DATA_PROVIDER=api_football

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Preserve literal \\n separators when copying the service-account private key into one line.
FIREBASE_PRIVATE_KEY=

OPENAI_API_KEY=

SIGNAL_MIN_PROBABILITY=0.75
SIGNAL_MIN_EDGE=0.05
SIGNAL_MIN_DATA_QUALITY=0.70
SIGNAL_MIN_SMART_SCORE=75
SIGNAL_COOLDOWN_SECONDS=300

LIVE_FIXTURE_POLL_SECONDS=15
LIVE_EVENT_POLL_SECONDS=15
LIVE_STATS_POLL_SECONDS=60
LIVE_ODDS_POLL_SECONDS=15

# Comma-separated IDs for the selected provider. For football_data, PL=2021 and LaLiga=2014.
# Empty means a safe no-op prematch worker.
PREMATCH_LEAGUE_IDS=
# Optional development/backfill season. Leave empty to use the provider's current season.
PREMATCH_SEASON_OVERRIDE=
PREMATCH_SYNC_INTERVAL_SECONDS=21600
PREMATCH_LOOKAHEAD_DAYS=14
PREMATCH_HISTORY_DAYS=365
PREMATCH_ENRICHMENT_LIMIT=10
PREMATCH_H2H_LAST=10
PREMATCH_QUOTA_RESERVE=10
PREMATCH_LINEUP_WINDOW_MINUTES=120
PREMATCH_PREDICTION_HORIZON_HOURS=48
PREMATCH_ODDS_HORIZON_HOURS=72
PREMATCH_ODDS_LIMIT=20
LIVE_CANDIDATE_WARMUP_MINUTES=30
LIVE_CANDIDATE_STALE_HOURS=4
LIVE_MAX_CONCURRENCY=4
PREMATCH_WORKER_LOCK_SECONDS=1800
LIVE_WORKER_LOCK_SECONDS=45
ODDS_WORKER_LOCK_SECONDS=45
ODDS_TARGET_LIMIT=100
ODDS_MOVEMENT_PROBABILITY_DELTA=0.02
ODDS_MOVEMENT_RELATIVE_PRICE_CHANGE=0.05

# Provider-neutral links let current football-data fixtures reuse API-Football history.
INTELLIGENCE_LEAGUE_LINKS=api_football:39,football_data:2021;api_football:140,football_data:2014
PROBABILITY_HORIZON_DAYS=14
PROBABILITY_TARGET_LIMIT=200
PROBABILITY_WORKER_INTERVAL_SECONDS=21600
PROBABILITY_WORKER_LOCK_SECONDS=1800
SIGNAL_WORKER_INTERVAL_SECONDS=15
SIGNAL_WORKER_LOCK_SECONDS=45
SIGNAL_TARGET_LIMIT=100
SIGNAL_MATERIAL_ODDS_CHANGE=0.05
SIGNAL_MATERIAL_EDGE_CHANGE=0.02
SIGNAL_MATERIAL_SMART_SCORE_CHANGE=5
SETTLEMENT_WORKER_INTERVAL_SECONDS=60
SETTLEMENT_WORKER_LOCK_SECONDS=120
SETTLEMENT_TARGET_LIMIT=500
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
NOTIFICATION_WORKER_LOCK_SECONDS=45
NOTIFICATION_TARGET_LIMIT=100
WORKER_FAILURE_BACKOFF_SECONDS=30
WORKER_RUN_ONCE=false

DEMO_MODE=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,test,testserver
MAX_REQUEST_BODY_BYTES=1048576
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_TIMEOUT_SECONDS=2
