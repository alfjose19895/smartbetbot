# SmartBetBot - Multi-Sport Environment Configuration (Vercel + Supabase + Sports APIs)

# 1. Supabase (Database & Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 2. Football Data Provider (API-Football)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# 3. Multi-Sport Feature Flags & Providers (Server-Side Only)
# NBA (Basketball)
NBA_ENABLED=true
NBA_LIVE_ENABLED=false
NBA_MONTE_CARLO_SIMULATIONS=20000
API_NBA_KEY=
API_NBA_BASE_URL=https://v1.basketball.api-sports.io

# NFL (American Football)
NFL_ENABLED=true
NFL_LIVE_ENABLED=false
NFL_MONTE_CARLO_SIMULATIONS=20000
API_NFL_KEY=
API_NFL_BASE_URL=https://v1.american-football.api-sports.io

# NCAAF (College Football)
NCAAF_ENABLED=true
NCAAF_LIVE_ENABLED=false
NCAAF_MONTE_CARLO_SIMULATIONS=20000
API_NCAAF_KEY=
API_NCAAF_BASE_URL=https://v1.american-football.api-sports.io

# NHL (Ice Hockey)
NHL_ENABLED=true
NHL_LIVE_ENABLED=false
NHL_MONTE_CARLO_SIMULATIONS=20000
API_NHL_KEY=
API_NHL_BASE_URL=https://v1.hockey.api-sports.io

# 4. Application & Deployment
NEXT_PUBLIC_APP_URL=https://smartbetbot.vercel.app

# 5. Optional Vercel Cron Secret (for securing /api/cron/sync and /api/cron/sync-multisport)
CRON_SECRET=
